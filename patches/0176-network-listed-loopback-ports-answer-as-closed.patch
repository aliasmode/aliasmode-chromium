diff --git a/services/network/closed_loopback_ports.cc b/services/network/closed_loopback_ports.cc
new file mode 100644
index 0000000..695761d
--- /dev/null
+++ b/services/network/closed_loopback_ports.cc
@@ -0,0 +1,202 @@
+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "services/network/closed_loopback_ports.h"
+
+#include <stdint.h>
+
+#include <memory>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/sequence_checker.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "net/base/address_family.h"
+#include "net/base/host_port_pair.h"
+#include "net/base/ip_address.h"
+#include "net/base/ip_endpoint.h"
+#include "net/base/net_errors.h"
+#include "net/base/network_anonymization_key.h"
+#include "net/base/schemeful_site.h"
+#include "net/base/url_util.h"
+#include "net/log/net_log_source.h"
+#include "net/socket/tcp_socket.h"
+#include "services/network/public/cpp/ip_address_space_util.h"
+#include "services/network/public/mojom/client_security_state.mojom.h"
+#include "services/network/public/mojom/ip_address_space.mojom.h"
+#include "url/scheme_host_port.h"
+#include "url/url_constants.h"
+
+namespace network {
+
+namespace {
+
+constexpr char kAliasModeClosedLoopbackPorts[] =
+    "aliasmode-closed-loopback-ports";
+
+// Attempts at a port that is free on both 127.0.0.1 and [::1] before the
+// sink settles for IPv4 alone.
+constexpr int kSinkBindAttempts = 16;
+
+bool IsHttpScheme(std::string_view scheme) {
+  return scheme == url::kHttpScheme || scheme == url::kHttpsScheme;
+}
+
+class ClosedLoopbackPorts {
+ public:
+  static ClosedLoopbackPorts& Get() {
+    static base::NoDestructor<ClosedLoopbackPorts> instance;
+    return *instance;
+  }
+
+  ClosedLoopbackPorts() {
+    const base::CommandLine& command_line =
+        *base::CommandLine::ForCurrentProcess();
+    if (!command_line.HasSwitch(kAliasModeClosedLoopbackPorts)) {
+      return;
+    }
+    const std::string value =
+        command_line.GetSwitchValueASCII(kAliasModeClosedLoopbackPorts);
+    for (std::string_view item : base::SplitStringPiece(
+             value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      const std::vector<std::string_view> bounds = base::SplitStringPiece(
+          item, "-", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+      unsigned first = 0;
+      unsigned last = 0;
+      if (bounds.empty() || bounds.size() > 2 ||
+          !base::StringToUint(bounds.front(), &first) ||
+          !base::StringToUint(bounds.back(), &last) || first < 1 ||
+          last > 65535 || first > last) {
+        LOG(WARNING) << "--" << kAliasModeClosedLoopbackPorts << ": ignoring '"
+                     << item << "'";
+        continue;
+      }
+      ranges_.emplace_back(static_cast<int>(first), static_cast<int>(last));
+    }
+  }
+
+  ClosedLoopbackPorts(const ClosedLoopbackPorts&) = delete;
+  ClosedLoopbackPorts& operator=(const ClosedLoopbackPorts&) = delete;
+
+  bool IsListed(int port) const {
+    for (const auto& [first, last] : ranges_) {
+      if (port >= first && port <= last) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // The port every closed connection is sent to, bound on the first call.
+  uint16_t SinkPort() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (!sink_bound_) {
+      sink_bound_ = true;
+      BindSink();
+    }
+    return sink_port_;
+  }
+
+ private:
+  // Binds 127.0.0.1:X and [::1]:X with one X and never listens, so a
+  // connection to X on either loopback address is refused, as on a closed
+  // port, and nothing else on this machine can take X while the browser
+  // runs. Where [::1] cannot be bound at all, IPv4 alone is kept.
+  void BindSink() {
+    for (int attempt = 0; attempt < kSinkBindAttempts; ++attempt) {
+      std::unique_ptr<net::TCPSocket> v4 =
+          net::TCPSocket::Create(nullptr, nullptr, net::NetLogSource());
+      net::IPEndPoint v4_address;
+      if (v4->Open(net::ADDRESS_FAMILY_IPV4) != net::OK ||
+          v4->Bind(net::IPEndPoint(net::IPAddress::IPv4Localhost(), 0)) !=
+              net::OK ||
+          v4->GetLocalAddress(&v4_address) != net::OK) {
+        continue;
+      }
+      std::unique_ptr<net::TCPSocket> v6 =
+          net::TCPSocket::Create(nullptr, nullptr, net::NetLogSource());
+      int v6_result = v6->Open(net::ADDRESS_FAMILY_IPV6);
+      if (v6_result == net::OK) {
+        v6_result = v6->Bind(net::IPEndPoint(net::IPAddress::IPv6Localhost(),
+                                             v4_address.port()));
+      }
+      if (v6_result == net::ERR_ADDRESS_IN_USE ||
+          v6_result == net::ERR_ACCESS_DENIED) {
+        // [::1] works but X is taken there: try another X.
+        continue;
+      }
+      sink_v4_ = std::move(v4);
+      if (v6_result == net::OK) {
+        sink_v6_ = std::move(v6);
+      }
+      sink_port_ = v4_address.port();
+      return;
+    }
+    // Port 0 is refused before any connection is tried, so a listed port
+    // still never reaches its service.
+    LOG(ERROR) << "--" << kAliasModeClosedLoopbackPorts
+               << ": no loopback port could be bound";
+  }
+
+  std::vector<std::pair<int, int>> ranges_;
+  bool sink_bound_ = false;
+  uint16_t sink_port_ = 0;
+  std::unique_ptr<net::TCPSocket> sink_v4_;
+  std::unique_ptr<net::TCPSocket> sink_v6_;
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace
+
+GURL MaybeCloseLoopbackPort(
+    const GURL& url,
+    const std::optional<url::Origin>& initiator,
+    const mojom::ClientSecurityState* client_security_state) {
+  ClosedLoopbackPorts& ports = ClosedLoopbackPorts::Get();
+  if (!(url.SchemeIsHTTPOrHTTPS() || url.SchemeIsWSOrWSS()) ||
+      !ports.IsListed(url.EffectiveIntPort()) || !net::IsLocalhost(url)) {
+    return url;
+  }
+  // A sandboxed frame's opaque origin keeps the scheme of its creator.
+  if (!initiator ||
+      !IsHttpScheme(initiator->GetTupleOrPrecursorTupleIfOpaque().scheme())) {
+    return url;
+  }
+  const mojom::IPAddressSpace initiator_space =
+      client_security_state ? client_security_state->ip_address_space
+                            : mojom::IPAddressSpace::kUnknown;
+  if (!IsLessPublicAddressSpace(mojom::IPAddressSpace::kLoopback,
+                                initiator_space)) {
+    return url;
+  }
+  const std::string port = base::NumberToString(ports.SinkPort());
+  GURL::Replacements replacements;
+  replacements.SetPortStr(port);
+  return url.ReplaceComponents(replacements);
+}
+
+void MaybeCloseLoopbackPort(
+    net::HostPortPair& destination,
+    const net::NetworkAnonymizationKey& network_anonymization_key) {
+  ClosedLoopbackPorts& ports = ClosedLoopbackPorts::Get();
+  if (!ports.IsListed(destination.port()) ||
+      !net::HostStringIsLocalhost(destination.host())) {
+    return;
+  }
+  const std::optional<net::SchemefulSite>& top_frame_site =
+      network_anonymization_key.GetTopFrameSite();
+  if (top_frame_site && !top_frame_site->opaque() &&
+      !IsHttpScheme(top_frame_site->GetURL().scheme())) {
+    return;
+  }
+  destination.set_port(ports.SinkPort());
+}
+
+}  // namespace network
