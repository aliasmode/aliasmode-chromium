+++ b/services/network/closed_loopback_ports.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef SERVICES_NETWORK_CLOSED_LOOPBACK_PORTS_H_
+#define SERVICES_NETWORK_CLOSED_LOOPBACK_PORTS_H_
+
+#include <optional>
+
+#include "base/component_export.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace net {
+class HostPortPair;
+class NetworkAnonymizationKey;
+}  // namespace net
+
+namespace network {
+
+namespace mojom {
+class ClientSecurityState;
+}  // namespace mojom
+
+// AliasMode: --aliasmode-closed-loopback-ports=<ports and a-b ranges> makes
+// the listed ports on this machine's loopback addresses answer a web page as
+// a closed port does. A request a page makes to one of them is sent to a port
+// of the same loopback host that this process holds bound and never listens
+// on, so the operating system refuses it as it refuses any closed port: same
+// error, same timing, and nothing reaches the service on the listed port.
+// The local network access checks and prompts are unchanged. Requests from
+// the browser itself, from extensions, and from pages on loopback are
+// untouched. Without the switch nothing changes.
+
+// Returns `url` with its port replaced by the closed port's when `url` is an
+// http(s) or ws(s) URL of a loopback host (127.0.0.0/8, [::1], localhost) on
+// a listed port, `initiator` is an http(s) origin (or an opaque origin created
+// by one), and the initiator's address space is more public than loopback. A
+// missing `client_security_state` counts as public. Else returns `url`.
+COMPONENT_EXPORT(NETWORK_SERVICE)
+GURL MaybeCloseLoopbackPort(
+    const GURL& url,
+    const std::optional<url::Origin>& initiator,
+    const mojom::ClientSecurityState* client_security_state);
+
+// The same for a WebRTC TCP connection (TURN over TCP or TLS), which carries
+// no initiator: the port of `destination` is replaced when its host is a
+// loopback host, the port is listed, and the connection is not for a
+// top-frame site of another scheme, such as an extension's.
+COMPONENT_EXPORT(NETWORK_SERVICE)
+void MaybeCloseLoopbackPort(
+    net::HostPortPair& destination,
+    const net::NetworkAnonymizationKey& network_anonymization_key);
+
+}  // namespace network
+
+#endif  // SERVICES_NETWORK_CLOSED_LOOPBACK_PORTS_H_
