+// The persona's devices replace the host's, whatever the host has. Only the
+// routing follows the host: device i opens host device i, a microphone beyond
+// the host's count opens host microphone 0, a camera beyond it is synthetic,
+// and speakers play on the host's default output.
+class ApostatePersonaDevicesTest : public testing::Test {
+ protected:
+  void Use(std::string_view json) {
+    profile_ = ProfileTestPeer::Parse(json);
+    ASSERT_TRUE(profile_);
+    Profile::SetForTesting(profile_.get());
+  }
+  void TearDown() override { Profile::SetForTesting(nullptr); }
+
+ private:
+  std::unique_ptr<Profile> profile_;
+};
+
+constexpr char kTwoMicrophonesOneCamera[] =
+    R"({"media":{"audioinput_count":2,"audiooutput_count":1,)"
+    R"("videoinput_count":1,"devices":[)"
+    R"({"kind":"audioinput","label":"Microphone Array (Realtek(R) Audio)",)"
+    R"("group":"card","audio":{"sample_rate":44100,"channels":2,)"
+    R"("buffer_frames":441}},)"
+    R"({"kind":"audioinput","label":"Microphone (HD Pro Webcam C920)",)"
+    R"("group":"c920"},)"
+    R"({"kind":"audiooutput","label":"Speakers (Realtek(R) Audio)",)"
+    R"("group":"card"},)"
+    R"({"kind":"videoinput","label":"HD Pro Webcam C920 (046d:082d)",)"
+    R"("group":"c920","facing":"user","formats":"hd"}]}})";
+
+TEST_F(ApostatePersonaDevicesTest, ThePersonaListIsTheSameOnEveryHost) {
+  Use(kTwoMicrophonesOneCamera);
+  for (size_t host = 0; host < 4; ++host) {
+    const std::vector<PersonaMediaDevice> microphones =
+        PersonaDevices(MediaDeviceKind::kAudioInput, host);
+    ASSERT_EQ(2u, microphones.size());
+    EXPECT_EQ("apostate-audioinput-0", microphones[0].id);
+    EXPECT_EQ("Microphone Array (Realtek(R) Audio)", microphones[0].label);
+    EXPECT_EQ("apostate-group-card", microphones[0].group_id);
+    EXPECT_EQ("apostate-audioinput-1", microphones[1].id);
+    EXPECT_EQ("Microphone (HD Pro Webcam C920)", microphones[1].label);
+    EXPECT_EQ("apostate-group-c920", microphones[1].group_id);
+  }
+}
+
+TEST_F(ApostatePersonaDevicesTest, RoutesFollowTheHost) {
+  Use(kTwoMicrophonesOneCamera);
+
+  std::vector<PersonaMediaDevice> microphones =
+      PersonaDevices(MediaDeviceKind::kAudioInput, 3);
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice, microphones[0].route);
+  EXPECT_EQ(0u, microphones[0].host_index);
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice, microphones[1].route);
+  EXPECT_EQ(1u, microphones[1].host_index);
+
+  microphones = PersonaDevices(MediaDeviceKind::kAudioInput, 1);
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice, microphones[1].route);
+  EXPECT_EQ(0u, microphones[1].host_index);
+
+  microphones = PersonaDevices(MediaDeviceKind::kAudioInput, 0);
+  EXPECT_EQ(MediaDeviceRoute::kSynthetic, microphones[0].route);
+  EXPECT_EQ(MediaDeviceRoute::kSynthetic, microphones[1].route);
+
+  EXPECT_EQ(MediaDeviceRoute::kHostDefault,
+            PersonaDevices(MediaDeviceKind::kAudioOutput, 2)[0].route);
+  EXPECT_EQ(MediaDeviceRoute::kSynthetic,
+            PersonaDevices(MediaDeviceKind::kAudioOutput, 0)[0].route);
+
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice,
+            PersonaDevices(MediaDeviceKind::kVideoInput, 2)[0].route);
+  EXPECT_EQ(MediaDeviceRoute::kSynthetic,
+            PersonaDevices(MediaDeviceKind::kVideoInput, 0)[0].route);
+
+  const std::optional<PersonaMediaDevice> second =
+      ResolveRoute("apostate-audioinput-1", 1);
+  ASSERT_TRUE(second);
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice, second->route);
+  EXPECT_EQ(0u, second->host_index);
+  EXPECT_FALSE(ResolveRoute("apostate-audioinput-2", 1));
+  EXPECT_FALSE(ResolveRoute("default", 1));
+}
+
+TEST_F(ApostatePersonaDevicesTest, ATrackReportsThePersonaDevice) {
+  Use(kTwoMicrophonesOneCamera);
+  const std::vector<PersonaMediaDevice> microphones =
+      PersonaDevices(MediaDeviceKind::kAudioInput, 1);
+  EXPECT_EQ(44100, microphones[0].sample_rate);
+  EXPECT_EQ(2, microphones[0].channels);
+  EXPECT_EQ(441, microphones[0].buffer_frames);
+  EXPECT_EQ(kSyntheticAudioInputSampleRate, microphones[1].sample_rate);
+  EXPECT_EQ(kSyntheticAudioInputChannels, microphones[1].channels);
+
+  const PersonaMediaDevice camera =
+      PersonaDevices(MediaDeviceKind::kVideoInput, 1)[0];
+  EXPECT_EQ("HD Pro Webcam C920 (046d:082d)", camera.label);
+  EXPECT_EQ("user", camera.facing);
+  EXPECT_EQ(1280, camera.max_width);
+  EXPECT_EQ(720, camera.max_height);
+}
+
+TEST_F(ApostatePersonaDevicesTest, ASpareDeviceKeepsTheHostsUsable) {
+  Use(R"({"media":{"audioinput_count":0,"audiooutput_count":1,)"
+      R"("videoinput_count":0,"devices":[)"
+      R"({"kind":"audiooutput","label":"Mac mini Speakers","group":"b"}],)"
+      R"("spare_devices":[)"
+      R"({"kind":"videoinput","label":"FaceTime HD Camera","group":"c"}]}})");
+  EXPECT_TRUE(PersonaDevices(MediaDeviceKind::kVideoInput, 0).empty());
+  const std::vector<PersonaMediaDevice> cameras =
+      PersonaDevices(MediaDeviceKind::kVideoInput, 2);
+  ASSERT_EQ(1u, cameras.size());
+  EXPECT_EQ("FaceTime HD Camera", cameras[0].label);
+  EXPECT_EQ(MediaDeviceRoute::kHostDevice, cameras[0].route);
+  // No spare microphone is named, so the host's stays hidden.
+  EXPECT_TRUE(PersonaDevices(MediaDeviceKind::kAudioInput, 1).empty());
+  EXPECT_TRUE(PersonaOwnsDevices(MediaDeviceKind::kAudioInput));
+}
+
+TEST_F(ApostatePersonaDevicesTest, WithoutACountTheHostListStands) {
+  Use(R"({"screen":{"width":1710}})");
+  EXPECT_FALSE(PersonaOwnsDevices(MediaDeviceKind::kVideoInput));
+  EXPECT_TRUE(PersonaDevices(MediaDeviceKind::kVideoInput, 1).empty());
+}
