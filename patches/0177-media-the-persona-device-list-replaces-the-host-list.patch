-// A device the profile claims and the host does not have.
+enum class MediaDeviceKind { kAudioInput, kAudioOutput, kVideoInput };
+
+// What opens when a page opens a device of the persona's machine.
+enum class MediaDeviceRoute {
+  // No host device of the kind exists: the synthetic camera, the room-tone
+  // microphone, or the hardware-less output.
+  kSynthetic,
+  // The host device at `host_index` in the host's own enumeration order.
+  kHostDevice,
+  // The host's default device of the kind. Speakers route here, so sound
+  // plays wherever the host's user has chosen to hear it.
