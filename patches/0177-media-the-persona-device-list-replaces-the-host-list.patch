+  // Microphones: the capture format a track reports.
+  int sample_rate = kSyntheticAudioInputSampleRate;
+  int channels = kSyntheticAudioInputChannels;
+  int buffer_frames = kSyntheticAudioInputBufferFrames;
 };
 
