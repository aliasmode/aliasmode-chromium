-std::vector<SyntheticMediaDevice> SyntheticAudioOutputDevices(
-    size_t host_device_count) {
+std::vector<PersonaMediaDevice> PersonaDevices(MediaDeviceKind kind,
+                                               size_t host_device_count) {
+  std::vector<PersonaMediaDevice> result;
   const Profile* profile = Profile::Get();
   if (!profile) {
-    return {};
+    return result;
+  }
+  const std::optional<int> count = Count(*profile, kind);
+  if (!count.has_value() || *count < 0) {
+    return result;
+  }
+
+  const std::string_view kind_name = KindName(kind);
+  std::vector<const Profile::MediaDevice*> named =
+      OfKind(profile->media_devices(), kind_name);
+  size_t wanted = static_cast<size_t>(*count);
+  if (wanted == 0 && host_device_count > 0) {
+    named = OfKind(profile->media_spare_devices(), kind_name);
+    wanted = std::min<size_t>(named.size(), 1);
   }
-  return Build(*profile, profile->media_audiooutput_count(), "audiooutput",
-               kAudioOutputPrefix, host_device_count);
+
+  const std::string_view prefix = Prefix(kind);
+  for (size_t i = 0; i < wanted; ++i) {
+    PersonaMediaDevice device;
+    device.id = StrCat({prefix, NumberToString(i)});
+    device.label = LabelForIndex(named, i);
+    // The pairing key, not the label. Namespaced so it cannot equal a
+    // platform group id.
+    device.group_id = i < named.size()
+                          ? StrCat({"apostate-group-", named[i]->group})
+                          : StrCat({prefix, NumberToString(i), "-group"});
+
+    const Profile::MediaDevice* entry = i < named.size() ? named[i] : nullptr;
+    if (entry) {
+      device.facing = entry->facing;
+      if (entry->sample_rate > 0) {
+        device.sample_rate = entry->sample_rate;
+        device.channels = entry->channels;
+        device.buffer_frames = entry->buffer_frames;
+      }
+    }
+    ApplySizeClass(entry ? std::string_view(entry->formats) : "", &device);
+
+    if (host_device_count > 0) {
+      switch (kind) {
+        case MediaDeviceKind::kAudioInput:
+          device.route = MediaDeviceRoute::kHostDevice;
+          device.host_index = i < host_device_count ? i : 0;
+          break;
+        case MediaDeviceKind::kAudioOutput:
+          device.route = MediaDeviceRoute::kHostDefault;
+          break;
+        case MediaDeviceKind::kVideoInput:
+          if (i < host_device_count) {
+            device.route = MediaDeviceRoute::kHostDevice;
+            device.host_index = i;
+          }
+          break;
+      }
+    }
+    result.push_back(std::move(device));
+  }
+  return result;
 }
 
