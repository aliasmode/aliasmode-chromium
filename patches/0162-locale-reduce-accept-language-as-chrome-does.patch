Subject: [PATCH] locale: reduce Accept-Language as Chrome does

Google Chrome turns on ReduceAcceptLanguage through a field trial. This
build runs no field trials, so it differed from Chrome 155 in two ways a
server or page can see: navigator.languages listed every language (en-US,
en) where Chrome lists only the first (en-US), and the network service
appended Accept-Language after the other navigation headers where Chrome
sends it right after sec-ch-ua-platform. Measured against Chrome for
Testing 155.0.8059.84 on tls.peet.ws. The feature is now on by default.

With it on, the browser chooses a navigation's Accept-Language from the
ReduceAcceptLanguageService's list, which read the language pref. That
service now takes the profile's list when the profile has one, as the
network service and the renderer already do (0013), so the header never
names the host's language while JavaScript names the profile's.

diff --git a/components/reduce_accept_language/browser/reduce_accept_language_service.cc b/components/reduce_accept_language/browser/reduce_accept_language_service.cc
index b5fcd4a..83ce5ba 100644
--- a/components/reduce_accept_language/browser/reduce_accept_language_service.cc
+++ b/components/reduce_accept_language/browser/reduce_accept_language_service.cc
@@ -6,6 +6,7 @@
 
 #include <string>
 
+#include "base/apostate/profile.h"
 #include "base/json/json_reader.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
@@ -146,10 +147,20 @@ void ReduceAcceptLanguageService::ClearReducedLanguage(
 
 void ReduceAcceptLanguageService::UpdateAcceptLanguage() {
   // In incognito mode return a genericized language list.
-  std::string accept_languages_str = net::HttpUtil::ExpandLanguageList(
+  std::string languages =
       is_incognito_
           ? language::GetIncognitoLanguageList(pref_accept_language_.GetValue())
-          : pref_accept_language_.GetValue());
+          : pref_accept_language_.GetValue();
+  // Apostate: the profile's list, as the network service and the renderer
+  // already use it (0013). The reduced Accept-Language of a navigation is
+  // chosen from this list, so reading the pref here would send the host's
+  // first language while navigator.languages reads the profile's.
+  if (const base::apostate::Profile* profile = base::apostate::Profile::Get();
+      profile && profile->accept_languages().has_value()) {
+    languages = *profile->accept_languages();
+  }
+  std::string accept_languages_str =
+      net::HttpUtil::ExpandLanguageList(languages);
   user_accept_languages_ = base::SplitString(
       accept_languages_str, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
 
diff --git a/services/network/public/cpp/features.cc b/services/network/public/cpp/features.cc
index e171770..e3558d8 100644
--- a/services/network/public/cpp/features.cc
+++ b/services/network/public/cpp/features.cc
@@ -209,7 +209,13 @@ BASE_FEATURE(kRestrictFrameDestinationsToNavigate,
 
 // Enables support for the `Variants` response header and reduce
 // accept-language. https://github.com/Tanych/accept-language
-BASE_FEATURE(kReduceAcceptLanguage, base::FEATURE_DISABLED_BY_DEFAULT);
+//
+// Apostate: on, as Google Chrome turns it on through a field trial. This build
+// runs no field trials, so navigator.languages listed every language where
+// Chrome lists one, and the network service appended Accept-Language after
+// the other navigation headers where Chrome sends it right after
+// sec-ch-ua-platform.
+BASE_FEATURE(kReduceAcceptLanguage, base::FEATURE_ENABLED_BY_DEFAULT);
 
 BASE_FEATURE_PARAM(base::TimeDelta,
                    kReduceAcceptLanguageCacheDuration,
