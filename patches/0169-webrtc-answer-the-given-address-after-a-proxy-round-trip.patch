+namespace {
+
+// Apostate: the longest round trip through the proxy the browser has timed for
+// this frame and its ancestor documents in this process: the TLS handshake of
+// each connection their document and subresource loads opened, which is one
+// round trip to that server with no server time in it. A STUN server a page
+// names is one of its servers or nearer, so a binding request answered for
+// --fingerprint-webrtc-ip never comes back sooner than it could. Without a
+// handshake, the document's wait for its response headers.
+std::optional<base::TimeDelta> DocumentRoundTrip(WebLocalFrame* web_frame) {
+  std::optional<base::TimeDelta> longest;
+  std::optional<base::TimeDelta> headers_wait;
+  const auto consider = [&longest](std::optional<base::TimeDelta> handshake) {
+    if (handshake && (!longest || *handshake > *longest)) {
+      longest = handshake;
+    }
+  };
+  for (Frame* frame = To<WebLocalFrameImpl>(web_frame)->GetFrame(); frame;
+       frame = frame->Tree().Parent()) {
+    auto* local_frame = DynamicTo<LocalFrame>(frame);
+    if (!local_frame) {
+      break;
+    }
+    DocumentLoader* loader = local_frame->Loader().GetDocumentLoader();
+    if (const ResourceLoadTiming* timing =
+            loader ? loader->GetResponse().GetResourceLoadTiming() : nullptr) {
+      if (!timing->SslStart().is_null() &&
+          timing->SslEnd() > timing->SslStart()) {
+        consider(timing->SslEnd() - timing->SslStart());
+      }
+      if (!headers_wait && !timing->SendEnd().is_null() &&
+          timing->ReceiveHeadersStart() > timing->SendEnd()) {
+        headers_wait = timing->ReceiveHeadersStart() - timing->SendEnd();
+      }
+    }
+    if (LocalDOMWindow* window = local_frame->DomWindow()) {
+      for (const auto& entry :
+           DOMWindowPerformance::performance(*window)->getBufferedEntriesByType(
+               performance_entry_names::kResource)) {
+        if (entry->IsResource()) {
+          consider(static_cast<const PerformanceResourceTiming*>(entry.Get())
+                       ->ApostateTlsHandshake());
+        }
+      }
+    }
+  }
+  return longest ? longest : headers_wait;
+}
