+  // The round trip, capped at a second, plus up to about a sixteenth of it.
+  // Without one, a typical round trip through a proxy.
+  TimeDelta AnswerDelay() const {
+    if (!round_trip_) {
+      return TimeDelta::Millis(base::RandIntInclusive(90, 160));
+    }
+    const int round_trip_ms = static_cast<int>(
+        std::clamp<int64_t>(round_trip_->ms(), 1, 1000));
+    return TimeDelta::Millis(
+        round_trip_ms + base::RandIntInclusive(1, 3 + round_trip_ms / 16));
+  }
