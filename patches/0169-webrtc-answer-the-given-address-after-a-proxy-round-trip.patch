+namespace {
+
+// Apostate: a round trip through the proxy to a server, as the browser timed
+// it loading the frame's document or the nearest ancestor document in this
+// process: its TLS handshake or its wait for the response headers, whichever
+// was shorter. Each takes at least one round trip through the proxy.
+std::optional<base::TimeDelta> DocumentRoundTrip(WebLocalFrame* web_frame) {
+  for (Frame* frame = To<WebLocalFrameImpl>(web_frame)->GetFrame(); frame;
+       frame = frame->Tree().Parent()) {
+    auto* local_frame = DynamicTo<LocalFrame>(frame);
+    if (!local_frame) {
+      break;
+    }
+    DocumentLoader* loader = local_frame->Loader().GetDocumentLoader();
+    const ResourceLoadTiming* timing =
+        loader ? loader->GetResponse().GetResourceLoadTiming() : nullptr;
+    if (!timing) {
+      continue;
+    }
+    std::optional<base::TimeDelta> round_trip;
+    if (!timing->SslStart().is_null() && timing->SslEnd() > timing->SslStart()) {
+      round_trip = timing->SslEnd() - timing->SslStart();
+    }
+    if (!timing->SendEnd().is_null() &&
+        timing->ReceiveHeadersStart() > timing->SendEnd()) {
+      const base::TimeDelta wait =
+          timing->ReceiveHeadersStart() - timing->SendEnd();
+      if (!round_trip || wait < *round_trip) {
+        round_trip = wait;
+      }
+    }
+    if (round_trip) {
+      return round_trip;
+    }
+  }
+  return std::nullopt;
+}
+
+}  // namespace
