+std::optional<base::TimeDelta> PerformanceResourceTiming::ApostateTlsHandshake()
+    const {
+  if (!info_->timing || !info_->timing->connect_timing ||
+      info_->timing->connect_timing->ssl_start.is_null() ||
+      info_->timing->connect_timing->ssl_end <=
+          info_->timing->connect_timing->ssl_start) {
+    return std::nullopt;
+  }
+  return info_->timing->connect_timing->ssl_end -
+         info_->timing->connect_timing->ssl_start;
