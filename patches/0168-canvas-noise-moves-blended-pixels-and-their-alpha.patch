+// A pixel's premultiplied colour on a 0 to 255 scale per channel, the space
+// in which anti-aliasing blends two colours along a straight line.
+using BlendPoint = std::array<double, 4>;
+
+BlendPoint PremultipliedUnits(const CanonicalPixel& value,
+                              const Channels& channels) {
+  const uint8_t alpha_index = channels.logical[3];
+  const double alpha =
+      alpha_index == Channels::kAbsent
+          ? 1.0
+          : static_cast<double>(value[3]) /
+                static_cast<double>(ChannelMax(channels, alpha_index));
+  BlendPoint point = {0, 0, 0, alpha * 255.0};
+  for (size_t c = 0; c < 3; ++c) {
+    const uint8_t storage_index = channels.logical[c];
+    if (storage_index == Channels::kAbsent) {
+      continue;
+    }
+    point[c] = static_cast<double>(value[c]) /
+               static_cast<double>(ChannelMax(channels, storage_index)) *
+               alpha * 255.0;
+  }
+  return point;
+}
+
+// True when the pixel and every neighbour lie, within rounding, on one line
+// between two colours, with the pixel strictly between its ends. That is what
+// anti-aliasing an edge between two colours leaves, in text and on curves. A
+// pattern a page draws pixel by pixel in colours of its own, such as a grid of
+// random colours, almost never lines up like that, so it reads back exactly.
+bool IsTwoColourBlend(const BlendPoint& centre,
+                      base::span<const BlendPoint> neighbours) {
+  constexpr double kTolerance = 1.5;
+  std::array<BlendPoint, 9> points;
+  size_t count = 0;
+  points[count++] = centre;
+  for (const BlendPoint& point : neighbours) {
+    points[count++] = point;
+  }
+  const auto distance2 = [](const BlendPoint& a, const BlendPoint& b) {
+    double sum = 0;
+    for (size_t c = 0; c < 4; ++c) {
+      sum += (a[c] - b[c]) * (a[c] - b[c]);
+    }
+    return sum;
+  };
+  size_t from = 0;
+  size_t to = 0;
+  double longest = 0;
+  for (size_t i = 0; i < count; ++i) {
+    for (size_t j = i + 1; j < count; ++j) {
+      const double d2 = distance2(points[i], points[j]);
+      if (d2 > longest) {
+        longest = d2;
+        from = i;
+        to = j;
+      }
+    }
   }
+  if (longest < 9.0) {
+    return false;
+  }
+  const BlendPoint& start = points[from];
+  BlendPoint direction;
+  for (size_t c = 0; c < 4; ++c) {
+    direction[c] = points[to][c] - start[c];
+  }
+  double centre_t = 0;
+  for (size_t i = 0; i < count; ++i) {
+    double dot = 0;
+    for (size_t c = 0; c < 4; ++c) {
+      dot += (points[i][c] - start[c]) * direction[c];
+    }
+    const double t = dot / longest;
+    for (size_t c = 0; c < 4; ++c) {
+      if (std::abs(points[i][c] - (start[c] + t * direction[c])) > kTolerance) {
+        return false;
+      }
+    }
+    if (i == 0) {
+      centre_t = t;
+    }
+  }
+  return centre_t > 0.02 && centre_t < 0.98;
 }
 
