Subject: [PATCH] audio: Mac ARM oscillator range math from the profile

Under a macOS ARM profile, the vector code that picks an oscillator's
wave-table range multiplies by a rounded reciprocal instead of dividing,
as the NEON code on Mac ARM does. The two methods round differently and
can pick a different table for the same frequency, which changes output
samples a page can hash. Other profiles keep plain division.

diff --git a/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.cc b/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.cc
index 841acdc2fe..1f58d88d56 100644
--- a/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.cc
+++ b/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.cc
@@ -10,6 +10,7 @@
 #include <memory>
 #include <numbers>
 
+#include "base/apostate/profile.h"
 #include "base/bit_cast.h"
 #include "base/check_op.h"
 #include "base/containers/span.h"
@@ -84,7 +85,11 @@ PeriodicWaveHandler::PeriodicWaveHandler(float sample_rate)
       number_of_ranges_(static_cast<unsigned>(
           std::lround(kNumberOfOctaveBands * log2f(periodic_wave_size_)))),
       lowest_fundamental_frequency_(sample_rate / periodic_wave_size_),
-      rate_scale_(periodic_wave_size_ / sample_rate) {}
+      rate_scale_(periodic_wave_size_ / sample_rate) {
+  const auto* profile = base::apostate::Profile::Get();
+  use_mac_arm_vector_math_ = profile && profile->ua_platform() == "macOS" &&
+                             profile->ua_architecture() == "arm";
+}
 
 void PeriodicWaveHandler::WaveDataForFundamentalFrequency(
     float fundamental_frequency,
@@ -140,8 +145,16 @@ void PeriodicWaveHandler::WaveDataForFundamentalFrequency(
   const __m128 pos = _mm_cmpgt_ps(frequency, _mm_set1_ps(0));
 
   // Calculate the pitch range.
-  __m128 v_ratio =
-      _mm_div_ps(frequency, _mm_set1_ps(lowest_fundamental_frequency_));
+  // NEON's vector recipe multiplies by a rounded reciprocal. Preserve both
+  // rounding steps for the Mac ARM profile; scalar playback keeps its recipe.
+  __m128 v_ratio;
+  if (use_mac_arm_vector_math_) {
+    v_ratio = _mm_mul_ps(
+        frequency, _mm_set1_ps(1 / lowest_fundamental_frequency_));
+  } else {
+    v_ratio =
+        _mm_div_ps(frequency, _mm_set1_ps(lowest_fundamental_frequency_));
+  }
 
   // Set v_ratio to 0 if freq <= 0; otherwise keep the ratio.
   v_ratio = _mm_and_ps(v_ratio, pos);
@@ -159,10 +172,12 @@ void PeriodicWaveHandler::WaveDataForFundamentalFrequency(
     cents_above_lowest_frequency[k] = log2f(ratio[k]) * kCentsPerOctave;
   }
 
-  __m128 v_pitch_range =
-      _mm_add_ps(_mm_set1_ps(1.0),
-                 _mm_div_ps(_mm_load_ps(cents_above_lowest_frequency.data()),
-                            _mm_set1_ps(kCentsPerRange)));
+  const __m128 cents = _mm_load_ps(cents_above_lowest_frequency.data());
+  const __m128 scaled_cents =
+      use_mac_arm_vector_math_
+          ? _mm_mul_ps(cents, _mm_set1_ps(1 / kCentsPerRange))
+          : _mm_div_ps(cents, _mm_set1_ps(kCentsPerRange));
+  __m128 v_pitch_range = _mm_add_ps(_mm_set1_ps(1.0), scaled_cents);
   v_pitch_range = _mm_max_ps(v_pitch_range, _mm_set1_ps(0.0));
   v_pitch_range = _mm_min_ps(v_pitch_range, _mm_set1_ps(number_of_ranges_ - 1));
 
diff --git a/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.h b/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.h
index 615b7b97c3..0e47b1245b 100644
--- a/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.h
+++ b/third_party/blink/renderer/modules/webaudio/periodic_wave_handler.h
@@ -106,6 +106,9 @@ class MODULES_EXPORT PeriodicWaveHandler final
   // sample. Calculated as periodic_wave_size_ / sample_rate.
   const float rate_scale_;
 
+  // Bound at construction from the existing immutable process profile.
+  bool use_mac_arm_vector_math_ = false;
+
   Vector<std::unique_ptr<AudioFloatArray>> band_limited_tables_;
 };
 
