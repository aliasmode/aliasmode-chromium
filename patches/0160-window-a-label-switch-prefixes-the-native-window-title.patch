Subject: [PATCH] window: a label switch prefixes the native window title

--aliasmode-window-label=<text> puts <text> in front of the title the OS
shows for every browser window and popup, so windows of different
profiles can be told apart in the taskbar and window switcher. The
launcher used to do this with a page script that rewrote document.title,
so every page could read the profile's label and saw its title changed.

The label is added where the window title is computed, in front of the
page title or of a "Name window" title. It is not stored as the window's
user title: that would replace the page title instead of prefixing it and
would be saved into the session. Pages, the tab strip and the session see
nothing. App and DevTools windows keep their own titles.

diff --git a/chrome/browser/ui/window_metadata/window_metadata_controller.cc b/chrome/browser/ui/window_metadata/window_metadata_controller.cc
index 2e7435b..82c11da 100644
--- a/chrome/browser/ui/window_metadata/window_metadata_controller.cc
+++ b/chrome/browser/ui/window_metadata/window_metadata_controller.cc
@@ -6,6 +6,9 @@
 
 #include <string>
 
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
 #include "base/strings/utf_string_conversions.h"
 #include "chrome/browser/picture_in_picture/picture_in_picture_window_manager.h"
 #include "chrome/browser/sessions/session_service.h"
@@ -36,6 +39,20 @@ namespace {
 
 using gfx::GetStringWidth;
 
+// AliasMode: --aliasmode-window-label=<text> puts <text> in front of the
+// native title of every browser window, so windows of different profiles can
+// be told apart in the taskbar and the window switcher. Only the title the OS
+// shows changes. document.title, the tab strip, the session and the "Name
+// window" user title stay as they were, so no page can read the label.
+constexpr char kAliasModeWindowLabel[] = "aliasmode-window-label";
+
+const std::u16string& WindowLabel() {
+  static const base::NoDestructor<std::u16string> label(base::UTF8ToUTF16(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueUTF8(
+          kAliasModeWindowLabel)));
+  return *label;
+}
+
 }  // namespace
 
 DEFINE_USER_DATA(WindowMetadataController);
@@ -77,8 +94,16 @@ gfx::Image WindowMetadataController::GetCurrentPageIcon() const {
 
 std::u16string WindowMetadataController::GetWindowTitleForCurrentTab(
     bool include_app_name) const {
+  // AliasMode: browser windows and the popups pages open carry the label.
+  // App and DevTools windows keep their own titles.
+  const std::u16string& label =
+      browser_->GetType() == BrowserWindowInterface::Type::TYPE_NORMAL ||
+              browser_->GetType() ==
+                  BrowserWindowInterface::Type::TYPE_POPUP
+          ? WindowLabel()
+          : base::EmptyString16();
   if (!user_title_.empty()) {
-    return base::UTF8ToUTF16(user_title_);
+    return label + base::UTF8ToUTF16(user_title_);
   }
 
   // For document picture-in-picture windows, we use the title from the opener
@@ -89,8 +114,8 @@ std::u16string WindowMetadataController::GetWindowTitleForCurrentTab(
           ? PictureInPictureWindowManager::GetInstance()->GetWebContents()
           : browser_->tab_strip_model()->GetActiveWebContents();
 
-  return GetWindowTitleFromWebContents(include_app_name,
-                                       web_contents_for_title);
+  return label + GetWindowTitleFromWebContents(include_app_name,
+                                               web_contents_for_title);
 }
 
 std::u16string WindowMetadataController::GetWindowTitleForTab(
