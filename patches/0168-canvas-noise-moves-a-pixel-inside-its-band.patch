+void ApostateNoiseReadbackRGBA8(
+    gpu::gles2::GLES2Interface* gl,
+    GLint x,
+    GLint y,
+    GLsizei width,
+    GLsizei height,
+    base::span<uint8_t> destination,
+    const WebGLImageConversion::PixelStoreParams& pack,
+    bool premultiplied) {
+  if (!apostate_readback_noise::Enabled() || !gl || width <= 0 ||
+      height <= 0) {
+    return;
+  }
+  ApostateReadbackGeometry geometry;
+  if (!ApostateReadbackGeometryFor(GL_RGBA, GL_UNSIGNED_BYTE, width, pack,
+                                   &geometry)) {
+    return;
+  }
+  base::CheckedNumeric<size_t> needed = geometry.row_stride;
+  needed *= static_cast<size_t>(height - 1);
+  needed += static_cast<size_t>(width) * 4;
+  needed += geometry.skip_bytes;
+  // The rectangle again, one pixel wider on every side, in tight rows. A
+  // pixel outside the framebuffer stays transparent black.
+  GLsizei wide = 0;
+  GLsizei tall = 0;
+  size_t bytes = 0;
+  if (!base::CheckAdd(width, 2).AssignIfValid(&wide) ||
+      !base::CheckAdd(height, 2).AssignIfValid(&tall) ||
+      !base::CheckMul(static_cast<size_t>(wide), static_cast<size_t>(tall), 4)
+           .AssignIfValid(&bytes) ||
+      !needed.IsValid() || needed.ValueOrDie() > destination.size()) {
+    return;
+  }
+  std::vector<uint8_t> clean(bytes, 0);
+  // The page's own pack state is put back afterwards. Only state the page
+  // changed is touched, so a WebGL 1 context never sees a WebGL 2 enum.
+  if (pack.alignment > 4) {
+    gl->PixelStorei(GL_PACK_ALIGNMENT, 4);
+  }
+  if (pack.row_length > 0) {
+    gl->PixelStorei(GL_PACK_ROW_LENGTH, 0);
+  }
+  if (pack.skip_pixels > 0) {
+    gl->PixelStorei(GL_PACK_SKIP_PIXELS, 0);
+  }
+  if (pack.skip_rows > 0) {
+    gl->PixelStorei(GL_PACK_SKIP_ROWS, 0);
+  }
+  gl->ReadPixels(x - 1, y - 1, wide, tall, GL_RGBA, GL_UNSIGNED_BYTE,
+                 clean.data());
+  if (pack.alignment > 4) {
+    gl->PixelStorei(GL_PACK_ALIGNMENT, pack.alignment);
+  }
+  if (pack.row_length > 0) {
+    gl->PixelStorei(GL_PACK_ROW_LENGTH, pack.row_length);
+  }
+  if (pack.skip_pixels > 0) {
+    gl->PixelStorei(GL_PACK_SKIP_PIXELS, pack.skip_pixels);
+  }
+  if (pack.skip_rows > 0) {
+    gl->PixelStorei(GL_PACK_SKIP_ROWS, pack.skip_rows);
+  }
+
+  const size_t wide_row = static_cast<size_t>(wide) * 4;
+  Surface surface;
+  surface.bytes = base::span(clean);
+  surface.width = wide;
+  surface.height = tall;
+  surface.row_stride = wide_row;
+  surface.pixel_stride = 4;
+  surface.channels.storage = Storage::kUint8;
+  surface.channels.premultiplied = premultiplied;
+  apostate_readback_noise::ApplyInside(surface, 1, 1, width + 1, height + 1);
+  const size_t row_bytes = static_cast<size_t>(width) * 4;
+  for (GLsizei row = 0; row < height; ++row) {
