+void ApplyToRegion(const Surface& surface, const Region& region) {
+  if (!Enabled() || !Walkable(surface, region)) {
     return;
   }
+  const Channels& channels = surface.channels;
+  if (channels.logical[0] == Channels::kAbsent &&
+      channels.logical[1] == Channels::kAbsent &&
+      channels.logical[2] == Channels::kAbsent) {
+    // Nothing but alpha: a mask, not a picture.
+    return;
+  }
+  if (WholeSurfaceIsOneValue(surface)) {
+    return;
+  }
+  if (channels.storage == Storage::kUint8) {
+    ApplyBands(surface, region);
+  } else {
+    ApplyLegacy(surface, region);
+  }
+}
