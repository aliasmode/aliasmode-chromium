+// ---- The 8-bit rule, which every canvas and WebGL fingerprint reads ----
+//
+// Each channel value falls in a band of up to four values. The bands start
+// 2 or 3 past a multiple of four, chosen per profile, so none lines up with a
+// power-of-two bucket: rounding the values to such a bucket, or dropping their
+// low bits, still shows a profile's own values somewhere. A value only ever
+// moves inside its band, and every decision below is taken on bands, so the
+// noise of a pixel already noised is itself: a read written back reads back
+// unchanged, an encoded copy decoded and read again equals the direct read,
+// and so does a read of part of the canvas.
+
+uint32_t BandOffset() {
+  return 2u + static_cast<uint32_t>((Seed() >> 61) & 1u);
+}
+
+// Band 0 holds 0 and the faintest values, up to `offset` + 3, so a faint
+// pixel can fade out and a faint edge still differs between profiles where
+// only the presence of alpha is hashed. Every later band is four values wide.
+uint32_t BandOf(uint32_t value, uint32_t offset) {
+  const uint32_t band = (value + 4u - offset) >> 2;
+  return band <= 1 ? 0 : band - 1;
+}
+
+// Picks a member of `value`'s band at or below `cap`. `pick` is uniform bits.
+uint32_t PickInBand(uint32_t value,
+                    uint32_t offset,
+                    uint32_t cap,
+                    uint32_t pick) {
+  const uint32_t band = BandOf(value, offset);
+  const int32_t start =
+      band == 0 ? 0
+                : static_cast<int32_t>(band) * 4 + static_cast<int32_t>(offset);
+  const int32_t end =
+      band == 0 ? static_cast<int32_t>(offset) + 3 : start + 3;
+  const int32_t low = start;
+  const int32_t high = std::min({end, 255, static_cast<int32_t>(cap)});
+  if (high < low) {
+    return std::min(value, cap);
+  }
+  return static_cast<uint32_t>(low) +
+         pick % static_cast<uint32_t>(high - low + 1);
+}
+
+uint64_t Mix(uint64_t value) {
+  value ^= value >> 30;
+  value *= 0xbf58476d1ce4e5b9ull;
+  value ^= value >> 27;
+  value *= 0x94d049bb133111ebull;
+  return value ^ (value >> 31);
+}
+
+// A pixel's red, green, blue and alpha in logical order. A store without
+// alpha reads as opaque and a missing colour as zero.
+std::array<uint32_t, 4> Rgba8(base::span<const uint8_t> pixel,
+                              const Channels& channels) {
+  std::array<uint32_t, 4> rgba = {0, 0, 0, 255};
+  for (size_t c = 0; c < 4; ++c) {
+    if (channels.logical[c] != Channels::kAbsent) {
+      rgba[c] = pixel[channels.logical[c]];
+    }
+  }
+  return rgba;
+}
+
+// The bands of a pixel, one byte per logical channel. Off the canvas a pixel
+// is transparent black, whose bands are all zero.
+uint32_t Coarse(const std::array<uint32_t, 4>& rgba, uint32_t offset) {
+  return BandOf(rgba[0], offset) | BandOf(rgba[1], offset) << 8 |
+         BandOf(rgba[2], offset) << 16 | BandOf(rgba[3], offset) << 24;
+}
