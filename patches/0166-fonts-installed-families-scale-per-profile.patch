 namespace blink {
@@ -73,6 +78,26 @@ int32_t FontCache::status_font_height_ = 0;
 
 namespace {
 
+// AliasMode: with --fingerprint-noise, each installed family is drawn and
+// measured 1 to 4 parts per thousand larger or smaller, by a factor fixed per
+// profile and family. The size is the one input every text surface derives
+// from -- shaping advances, ink bounds, line metrics, layout boxes, SVG text
+// and the glyphs a canvas rasterises -- so all of them stay consistent with
+// each other while two profiles on one host stop agreeing. Combining marks
+// keep their anchors because the whole font scales. Web fonts are left alone.
+float ProfileFontSizeScale(const SkTypeface& typeface) {
+  if (!base::apostate::ProfileNoiseEnabled()) {
+    return 1.0f;
+  }
+  SkString family;
+  typeface.getFamilyName(&family);
+  const uint64_t bits = base::apostate::ProfileNoiseBits(base::StrCat(
+      {"font-size/v1/",
+       base::ToLowerASCII(std::string_view(family.c_str(), family.size()))}));
+  const float magnitude = 0.001f + static_cast<float>(bits % 3001u) * 1e-6f;
+  return (bits >> 63) ? 1.0f + magnitude : 1.0f - magnitude;
+}
+
 int32_t EnsureMinimumFontHeightIfNeeded(int32_t font_height) {
   // Adjustment for codepage 936 to make the fonts more legible in Simplified
   // Chinese.  Please refer to LayoutThemeFontProviderWin.cpp for more
@@ -490,8 +515,9 @@ const FontPlatformData* FontCache::CreateFontPlatformData(
        !typeface->isItalic()) ||
       font_description.IsSyntheticItalic();
 
+  const float profile_font_size = font_size * ProfileFontSizeScale(*typeface);
   FontPlatformData* result = MakeGarbageCollected<FontPlatformData>(
-      typeface, name.data(), font_size,
