+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef SERVICES_DEVICE_GEOLOCATION_FIXED_LOCATION_PROVIDER_H_
+#define SERVICES_DEVICE_GEOLOCATION_FIXED_LOCATION_PROVIDER_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/timer/timer.h"
+#include "services/device/public/cpp/geolocation/location_provider.h"
+#include "services/device/public/mojom/geolocation_internals.mojom.h"
+#include "services/device/public/mojom/geoposition.mojom.h"
+
+namespace device {
+
+// AliasMode: serves the position --fingerprint-geolocation=<lat>,<lon>[,<m>]
+// names, as a stationary device would report it, and never asks the host or
+// the network where it is. One fix per start, 400 to 1200 ms after the
+// provider is started (only for a granted page); altitude, heading and speed
+// stay unset. A value that does not parse, or is out of range, yields
+// POSITION_UNAVAILABLE rather than the host's location.
+class FixedLocationProvider : public LocationProvider {
+ public:
+  // A provider when the switch is present, whatever its value, else nullptr.
+  static std::unique_ptr<LocationProvider> CreateIfRequested();
+
+  FixedLocationProvider();
+  FixedLocationProvider(const FixedLocationProvider&) = delete;
+  FixedLocationProvider& operator=(const FixedLocationProvider&) = delete;
+  ~FixedLocationProvider() override;
+
+  // LocationProvider implementation.
+  void FillDiagnostics(mojom::GeolocationDiagnostics& diagnostics) override;
+  void SetUpdateCallback(
+      const LocationProviderUpdateCallback& callback) override;
+  void StartProvider(bool high_accuracy) override;
+  void StopProvider() override;
+  const mojom::GeopositionResult* GetPosition() override;
+  void OnPermissionGranted() override;
+
+ private:
+  struct Fix {
+    double latitude;
+    double longitude;
+    double accuracy;
+  };
+
+  static std::optional<Fix> ParseSwitch();
+
+  void MaybeScheduleFix();
+  void ReportFix();
+
+  // Unset when the switch value is malformed or out of range.
+  const std::optional<Fix> fix_;
+
+  LocationProviderUpdateCallback callback_;
+  mojom::GeolocationDiagnostics::ProviderState state_ =
+      mojom::GeolocationDiagnostics::ProviderState::kStopped;
+  bool is_permission_granted_ = false;
+  mojom::GeopositionResultPtr result_;
+  base::OneShotTimer first_fix_timer_;
+};
+
+}  // namespace device
+
+#endif  // SERVICES_DEVICE_GEOLOCATION_FIXED_LOCATION_PROVIDER_H_
