+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#ifndef SERVICES_DEVICE_PUBLIC_CPP_GEOLOCATION_ALLOWED_SYSTEM_GEOLOCATION_SOURCE_H_
+#define SERVICES_DEVICE_PUBLIC_CPP_GEOLOCATION_ALLOWED_SYSTEM_GEOLOCATION_SOURCE_H_
+
+#include <memory>
+
+#include "base/component_export.h"
+#include "build/build_config.h"
+#include "services/device/public/cpp/geolocation/geolocation_system_permission_manager.h"
+#include "services/device/public/cpp/geolocation/system_geolocation_source.h"
+
+namespace device {
+
+// AliasMode: the system source of a launch with --fingerprint-geolocation.
+// Its position comes from the switch, so the operating system's location
+// permission is reported as allowed and its location settings and services
+// (CLLocationManager, WinRT Geolocator) are never touched. The site
+// permission prompt is unchanged.
+class COMPONENT_EXPORT(GEOLOCATION) AllowedSystemGeolocationSource
+    : public SystemGeolocationSource {
+ public:
+  // A manager over this source when the switch is present, else nullptr.
+  static std::unique_ptr<GeolocationSystemPermissionManager>
+  MaybeCreateGeolocationSystemPermissionManager();
+
+  AllowedSystemGeolocationSource();
+  AllowedSystemGeolocationSource(const AllowedSystemGeolocationSource&) =
+      delete;
+  AllowedSystemGeolocationSource& operator=(
+      const AllowedSystemGeolocationSource&) = delete;
+  ~AllowedSystemGeolocationSource() override;
+
+  // SystemGeolocationSource implementation:
+  void RegisterPermissionUpdateCallback(
+      PermissionUpdateCallback callback) override;
+#if BUILDFLAG(IS_APPLE)
+  void AddPositionUpdateObserver(PositionObserver* observer) override;
+  void RemovePositionUpdateObserver(PositionObserver* observer) override;
+  void StartWatchingPosition(bool high_accuracy) override;
+  void StopWatchingPosition() override;
+#endif
+#if BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_WIN)
+  void RequestPermission() override;
+#endif
+};
+
+}  // namespace device
+
+#endif  // SERVICES_DEVICE_PUBLIC_CPP_GEOLOCATION_ALLOWED_SYSTEM_GEOLOCATION_SOURCE_H_
