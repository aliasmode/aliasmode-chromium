diff --git a/services/device/geolocation/fixed_location_provider.cc b/services/device/geolocation/fixed_location_provider.cc
new file mode 100644
index 0000000..bb5a292
--- /dev/null
+++ b/services/device/geolocation/fixed_location_provider.cc
@@ -0,0 +1,135 @@
+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "services/device/geolocation/fixed_location_provider.h"
+
+#include <cmath>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/location.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/time/time.h"
+
+namespace device {
+
+namespace {
+
+constexpr char kFingerprintGeolocation[] = "fingerprint-geolocation";
+
+// The accuracy, in metres, of a value that names none: a Wi-Fi fix.
+constexpr double kDefaultAccuracyMeters = 50;
+
+// How long a first fix takes after the provider is started. A
+// fix at once would be faster than any provider a real device has.
+constexpr base::TimeDelta kFirstFixMin = base::Milliseconds(400);
+constexpr base::TimeDelta kFirstFixMax = base::Milliseconds(1200);
+
+}  // namespace
+
+// static
+std::unique_ptr<LocationProvider> FixedLocationProvider::CreateIfRequested() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kFingerprintGeolocation)) {
+    return nullptr;
+  }
+  return std::make_unique<FixedLocationProvider>();
+}
+
+// static
+std::optional<FixedLocationProvider::Fix> FixedLocationProvider::ParseSwitch() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kFingerprintGeolocation);
+  const std::vector<std::string_view> parts = base::SplitStringPiece(
+      value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 2 && parts.size() != 3) {
+    return std::nullopt;
+  }
+  Fix fix = {0, 0, kDefaultAccuracyMeters};
+  if (!base::StringToDouble(parts[0], &fix.latitude) ||
+      !base::StringToDouble(parts[1], &fix.longitude) ||
+      (parts.size() == 3 && !base::StringToDouble(parts[2], &fix.accuracy))) {
+    return std::nullopt;
+  }
+  if (!std::isfinite(fix.latitude) || !std::isfinite(fix.longitude) ||
+      !std::isfinite(fix.accuracy) || fix.latitude < -90 || fix.latitude > 90 ||
+      fix.longitude < -180 || fix.longitude > 180 || fix.accuracy < 0) {
+    return std::nullopt;
+  }
+  return fix;
+}
+
+FixedLocationProvider::FixedLocationProvider() : fix_(ParseSwitch()) {}
+
+FixedLocationProvider::~FixedLocationProvider() = default;
+
+void FixedLocationProvider::FillDiagnostics(
+    mojom::GeolocationDiagnostics& diagnostics) {
+  diagnostics.provider_state = state_;
+}
+
+void FixedLocationProvider::SetUpdateCallback(
+    const LocationProviderUpdateCallback& callback) {
+  callback_ = callback;
+}
+
+void FixedLocationProvider::StartProvider(bool high_accuracy) {
+  state_ = high_accuracy
+               ? mojom::GeolocationDiagnostics::ProviderState::kHighAccuracy
+               : mojom::GeolocationDiagnostics::ProviderState::kLowAccuracy;
+  MaybeScheduleFix();
+}
+
+void FixedLocationProvider::StopProvider() {
+  state_ = mojom::GeolocationDiagnostics::ProviderState::kStopped;
+  first_fix_timer_.Stop();
+}
+
+const mojom::GeopositionResult* FixedLocationProvider::GetPosition() {
+  return result_.get();
+}
+
+void FixedLocationProvider::OnPermissionGranted() {
+  is_permission_granted_ = true;
+  MaybeScheduleFix();
+}
+
+void FixedLocationProvider::MaybeScheduleFix() {
+  // A stationary device reports one fix; a later start, such as a change of
+  // accuracy, keeps it.
+  if (state_ == mojom::GeolocationDiagnostics::ProviderState::kStopped ||
+      result_ || first_fix_timer_.IsRunning()) {
+    return;
+  }
+  first_fix_timer_.Start(FROM_HERE,
+                         base::RandTimeDelta(kFirstFixMin, kFirstFixMax), this,
+                         &FixedLocationProvider::ReportFix);
+}
+
+void FixedLocationProvider::ReportFix() {
+  if (fix_) {
+    // Altitude, altitude accuracy, heading and speed keep their unset
+    // sentinels, which a page reads as null.
+    auto position = mojom::Geoposition::New();
+    position->latitude = fix_->latitude;
+    position->longitude = fix_->longitude;
+    position->accuracy = fix_->accuracy;
+    position->timestamp = base::Time::Now();
+    result_ = mojom::GeopositionResult::NewPosition(std::move(position));
+  } else {
+    result_ = mojom::GeopositionResult::NewError(mojom::GeopositionError::New(
+        mojom::GeopositionErrorCode::kPositionUnavailable,
+        mojom::kGeoPositionUnavailableErrorMessage, ""));
+  }
+  if (callback_) {
+    callback_.Run(this, result_.Clone());
+  }
+}
+
+}  // namespace device
