+// Copyright 2026 The AliasMode Authors
+// Use of this source code is governed by a GPL-3.0 license that can be
+// found in the LICENSE file.
+
+#include "services/device/public/cpp/geolocation/allowed_system_geolocation_source.h"
+
+#include <utility>
+
+#include "base/command_line.h"
+#include "services/device/public/cpp/geolocation/location_system_permission_status.h"
+
+namespace device {
+
+namespace {
+
+// Read by the fixed location provider in services/device/geolocation.
+constexpr char kFingerprintGeolocation[] = "fingerprint-geolocation";
+
+}  // namespace
+
+// static
+std::unique_ptr<GeolocationSystemPermissionManager>
+AllowedSystemGeolocationSource::
+    MaybeCreateGeolocationSystemPermissionManager() {
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          kFingerprintGeolocation)) {
+    return nullptr;
+  }
+  return std::make_unique<GeolocationSystemPermissionManager>(
+      std::make_unique<AllowedSystemGeolocationSource>());
+}
+
+AllowedSystemGeolocationSource::AllowedSystemGeolocationSource() = default;
+
+AllowedSystemGeolocationSource::~AllowedSystemGeolocationSource() = default;
+
+void AllowedSystemGeolocationSource::RegisterPermissionUpdateCallback(
+    PermissionUpdateCallback callback) {
+  // The status never changes, so the callback is run once and not kept.
+  std::move(callback).Run(LocationSystemPermissionStatus::kAllowed);
+}
+
+#if BUILDFLAG(IS_APPLE)
+// Positions come from the fixed provider, never from this source.
+void AllowedSystemGeolocationSource::AddPositionUpdateObserver(
+    PositionObserver* observer) {}
+
+void AllowedSystemGeolocationSource::RemovePositionUpdateObserver(
+    PositionObserver* observer) {}
+
+void AllowedSystemGeolocationSource::StartWatchingPosition(bool high_accuracy) {
+}
+
+void AllowedSystemGeolocationSource::StopWatchingPosition() {}
+#endif  // BUILDFLAG(IS_APPLE)
+
+#if BUILDFLAG(IS_APPLE) || BUILDFLAG(IS_WIN)
+void AllowedSystemGeolocationSource::RequestPermission() {}
+#endif
+
+}  // namespace device
